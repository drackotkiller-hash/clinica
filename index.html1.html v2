<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Turnos Clínica Alba</title>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500&family=Geist:wght@400;500;600&family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{--canvas:#0a0a0a;--graphite:#161616;--glass:rgba(212,212,212,.1);--bone:#ededed;--ash:#c2c2c2;--slate:#686868;--hair:#e5e5e5;--white:#fff;
--dm:'DM Sans',system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;--geist:'Geist',system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:90px;scroll-behavior:smooth}
*,*::before,*::after{box-sizing:border-box}
body{margin:0;background:var(--canvas);color:var(--bone);font:400 16px/1.5 var(--dm);letter-spacing:.01em}
button,select,input{font:inherit;color:inherit}
.wrap{max-width:1200px;margin:0 auto;padding:0 20px}
nav{position:fixed;top:calc(16px + env(safe-area-inset-top,0px));left:50%;transform:translateX(-50%);z-index:10;display:flex;align-items:center;gap:8px;padding:6px 6px 6px 16px;background:rgba(22,22,22,.8);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);border:1px solid var(--hair);border-radius:19px;max-width:calc(100% - 32px)}
nav b{font:500 15px var(--geist);margin-right:8px;white-space:nowrap}
.ghost{background:none;border:1px solid var(--hair);color:rgba(255,255,255,.85);border-radius:9999px;padding:6px 14px;font-size:14px;cursor:pointer;text-decoration:none;white-space:nowrap}
.ghost:hover,.ghost.on{background:var(--glass)}
.cta{background:var(--white);color:#161616;border:0;border-radius:9999px;padding:8px 14px;font-size:14px;cursor:pointer;white-space:nowrap}
.cta:hover{background:var(--bone)}
.cta:disabled{background:var(--slate);color:#161616;cursor:not-allowed}
:focus-visible{outline:2px solid var(--white);outline-offset:2px}
.hero{margin:12px;border-radius:24px;padding:140px 0 56px;background:linear-gradient(90deg,rgba(0,0,0,0),rgba(0,0,0,0) 40%,rgba(107,98,242,.565) 50%,rgba(0,0,0,0) 60%,rgba(0,0,0,0)) bottom/100% 2px no-repeat,#161616;border:1px solid rgba(229,229,229,.25);color:var(--bone)}
.hero .wrap{padding:0 28px}
h1{font:500 clamp(40px,8vw,72px)/1 var(--dm);letter-spacing:-.035em;margin:0 0 20px;max-width:760px}
.hero p{font:500 18px/1.5 var(--geist);max-width:520px;margin:0 0 32px;color:var(--ash)}
.stats{display:flex;gap:12px;flex-wrap:wrap;margin-top:40px}
.stat{background:rgba(10,10,10,.35);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);border:1px solid rgba(229,229,229,.25);border-radius:16px;padding:16px 24px;min-width:150px}
.stat b{display:block;font:500 36px/1.1 var(--geist)}
.stat span{font-size:14px;color:var(--bone)}
section{padding:72px 0 0}
h2{font:600 32px/1.3 var(--geist);margin:0 0 8px}
.sub{font:500 18px/1.5 var(--geist);color:var(--ash);margin:0 0 28px;max-width:620px}
.panel{background:var(--glass);border-radius:24px;padding:28px;backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px)}
.scroll{overflow-x:auto}
table{border-collapse:separate;border-spacing:0 8px;width:100%;min-width:720px}
th{font:400 13px var(--dm);letter-spacing:.03em;color:var(--ash);text-align:left;padding:0 4px 4px}
th small{display:block;color:var(--slate)}
th.today,th.today small{color:var(--white)}
td{padding:0 4px}
td.dr{min-width:190px;padding-right:16px}
td.dr b{display:block;font:500 16px var(--geist)}
td.dr span{font-size:13px;color:var(--ash)}
.cell{width:100%;min-height:44px;border-radius:10px;border:1px dashed rgba(229,229,229,.3);background:none;color:var(--slate);cursor:pointer;font-size:14px}
.cell:not(:disabled):hover{border-color:var(--hair);color:var(--bone)}
.cell.m{background:var(--bone);color:#161616;border:1px solid var(--bone)}
.cell.t{background:var(--glass);color:var(--white);border:1px solid var(--hair)}
.legend{display:flex;gap:16px;flex-wrap:wrap;font-size:13px;color:var(--ash);margin-top:16px;align-items:center}
.sw{display:inline-block;width:14px;height:14px;border-radius:4px;vertical-align:-2px;margin-right:6px}
.cols{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);gap:20px}
@media(max-width:860px){.cols{grid-template-columns:1fr}.hero{border-radius:28px}}
label{display:block;font-size:13px;letter-spacing:.03em;color:var(--ash);margin:16px 0 6px}
label:first-of-type{margin-top:0}
.f{width:100%;background:var(--graphite);border:1px solid var(--hair);border-radius:10px;padding:10px 12px;appearance:none;-webkit-appearance:none}
.f::placeholder{color:var(--slate)}
.slots{display:flex;flex-wrap:wrap;gap:8px}
.slot{background:none;border:1px solid var(--hair);border-radius:9999px;padding:6px 14px;font-size:14px;cursor:pointer;color:var(--bone)}
.slot:hover{background:var(--glass)}
.slot.on{background:var(--white);color:#161616}
.note{font-size:14px;color:var(--ash);margin:0}
.day h3{font:500 18px var(--geist);margin:24px 0 8px}
.day:first-child h3{margin-top:0}
.ap{display:flex;align-items:center;gap:16px;padding:12px 0;border-top:1px solid rgba(229,229,229,.15)}
.ap .h{font:500 16px var(--geist);min-width:52px}
.ap div{flex:1;min-width:0}
.ap b{display:block;font-weight:500;overflow-wrap:anywhere}
.ap span{font-size:13px;color:var(--ash)}
.x{background:none;border:1px solid var(--hair);border-radius:10px;padding:6px 10px;font-size:13px;cursor:pointer;color:var(--ash)}
.x:hover{background:var(--glass);color:var(--white)}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:20px}
footer{padding:72px 0 48px;color:var(--slate);font-size:13px}
#toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translate(-50%,20px);opacity:0;pointer-events:none;background:var(--graphite);border:1px solid var(--hair);border-radius:9999px;padding:8px 18px;font-size:14px;transition:.25s;z-index:20}
#toast.show{opacity:1;transform:translate(-50%,0)}
#welcome{min-height:100vh;min-height:100dvh;margin:0;display:flex;align-items:center;padding:96px 0 48px}
#welcome .wrap{width:100%;padding:0 20px}
.opts{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:40px auto 0;max-width:760px}
.opt{text-align:left;background:rgba(10,10,10,.4);backdrop-filter:blur(4px);-webkit-backdrop-filter:blur(4px);border:1px solid rgba(255,255,255,.5);border-radius:24px;padding:28px;color:#fff;cursor:pointer}
.opt:hover{background:#fff;color:#161616}
.opt b{display:block;font:500 24px/1.33 var(--geist);margin-bottom:6px}
.opt span{font-size:15px}
@media(max-width:620px){.opts{grid-template-columns:1fr}}
body.welcome nav,body.welcome header,body.welcome main,body.welcome footer,body.login nav,body.login header,body.login main,body.login footer{display:none}
body:not(.welcome) #welcome{display:none}
.role-p #turnos,.role-p #lnkT,.role-p #dia,.role-p #lnkD{display:none}
.role-m #form,.role-m #goNew,.role-m #goNew2{display:none}
.role-m .cols{grid-template-columns:1fr}
.role-m #citas{padding-top:72px}
/* Paciente: claro y acogedor (estilo Calendly) */
body.role-p{--canvas:#f8f9fb;--bone:#0b3558;--ash:#476788;--slate:#7a93ad;--hair:#d4e0ed;--glass:#fff;--white:#0b3558;--graphite:#f0f3f8;
--dm:'Manrope',system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;--geist:'Manrope',system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
--sh:rgba(71,103,136,.04) 0 4px 5px,rgba(71,103,136,.03) 0 8px 15px,rgba(71,103,136,.08) 0 30px 50px;letter-spacing:0}
.role-p :focus-visible{outline-color:#006bff}
.role-p nav{background:rgba(255,255,255,.92);border-color:#d4e0ed;border-radius:16px;box-shadow:var(--sh)}
.role-p .ghost{color:#0b3558;border-radius:8px;font-weight:500}
.role-p .ghost:hover{background:#f0f3f8}.role-p .ghost.on{background:#e6f0ff;color:#004eba;border-color:#b9d3f5}
.role-p .cta{background:#006bff;color:#fff;border-radius:8px;font-weight:600}
.role-p .cta:hover{background:#0058d6}.role-p .cta:disabled{background:#a6bbd1;color:#fff}
.role-p .hero{border-radius:24px;border:1px solid #d4e0ed;color:#0b3558;background:radial-gradient(circle at 88% 15%,rgba(229,92,255,.28),transparent 38%),radial-gradient(circle at 72% 95%,rgba(0,153,255,.28),transparent 42%),#fff}
.role-p h1{font:700 clamp(36px,6vw,64px)/1.2 var(--dm);letter-spacing:0;color:#0b3558}
.role-p .hero p{color:#476788;font-weight:500}
.role-p .stat{background:#fff;border:1px solid #d4e0ed;border-radius:16px;box-shadow:var(--sh);backdrop-filter:none;-webkit-backdrop-filter:none}
.role-p .stat b{color:#0b3558;font-weight:700}.role-p .stat span{color:#476788}
.role-p h2{font-weight:700;color:#0b3558}
.role-p .panel{background:#fff;border:1px solid #d4e0ed;border-radius:16px;box-shadow:var(--sh);backdrop-filter:none;-webkit-backdrop-filter:none}
.role-p .f{background:#f0f3f8;border-color:#d4e0ed;border-radius:8px;color:#0b3558}
.role-p .slot{border-color:#d4e0ed;border-radius:8px;color:#0b3558;font-weight:500}
.role-p .slot:hover{background:#e6f0ff;border-color:#006bff}.role-p .slot.on{background:#006bff;border-color:#006bff;color:#fff}
.role-p .ap{border-top-color:#e4ecf5}.role-p .x{border-radius:8px}.role-p .x:hover{background:#f0f3f8;color:#0b3558}
.role-p #toast{background:#0b3558;color:#fff;border-color:#0b3558}
.role-p footer{color:#7a93ad}
#wiz{padding-top:120px}
.role-m #wiz{display:none}
.role-p #citas,.role-p header,.role-p #lnkC{display:none}
.wz{max-width:720px;margin:0 auto}
.wz h2{font-size:clamp(28px,5vw,38px);line-height:1.2}
.wz h3{font:700 20px var(--geist);margin:32px 0 12px}
.wz label{margin:0 0 6px}
.wz .panel>*+*{margin-top:16px}
.wz .panel>.nav2{margin-top:28px}
.steps{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:28px}
.st{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:500;color:#7a93ad;border:1px solid #d4e0ed;border-radius:9999px;padding:4px 14px 4px 4px;background:#fff}
.st i{font-style:normal;display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:#f0f3f8;font-size:13px}
.st.on{color:#0b3558;border-color:#006bff}.st.on i{background:#006bff;color:#fff}
.st.ok{color:#0b3558}.st.ok i{background:#e6f0ff;color:#004eba}
.two{display:grid;grid-template-columns:1fr 1fr;gap:16px}
.two>.fld{margin:0!important}
.nav2{display:flex;justify-content:space-between;gap:12px}
.err{color:#b42318;font-size:13px;margin:6px 0 0}
.f.bad{border-color:#b42318}
.tipos{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.tp{text-align:left;background:#fff;border:1px solid #d4e0ed;border-radius:12px;padding:14px 16px;color:#0b3558;cursor:pointer}
.tp b{display:block;font-weight:600}.tp span{font-size:13px;color:#476788}
.tp:hover{border-color:#006bff}.tp:focus-visible{outline:2px solid #006bff}.tp[aria-pressed=true]{border-color:#006bff;background:#e6f0ff;box-shadow:0 0 0 1px #006bff inset}
dl.sum{display:grid;grid-template-columns:auto 1fr;gap:10px 24px;margin:0}
dl.sum dt{color:#476788;font-size:14px}dl.sum dd{margin:0;font-weight:600;overflow-wrap:anywhere}
.ok-ic{display:inline-grid;place-items:center;width:44px;height:44px;border-radius:50%;background:#e6f0ff;color:#006bff;font-size:22px;margin-bottom:16px}
body.role-p{background:radial-gradient(circle at 92% 8%,rgba(229,92,255,.16),transparent 30%),radial-gradient(circle at 85% 65%,rgba(0,153,255,.14),transparent 35%),#f8f9fb;background-attachment:fixed}
.role-p .cta{padding:10px 18px;font-size:16px}
@media(max-width:560px){.two,.tipos{grid-template-columns:1fr}}
#login{display:none;min-height:100vh;min-height:100dvh;align-items:center;padding:96px 0 48px}
body.login #login{display:flex}
#login .wrap{width:100%}
.lbox{max-width:480px;margin:0 auto;width:100%}
#login label{margin:0 0 6px}
#login .fld+.fld{margin-top:16px}
#lg-e{margin:16px 0 0}#lg-e:empty{display:none}
#login .nav2{margin-top:16px}
.cell:disabled{cursor:default;opacity:.5}
.cell.mt{background:var(--white);color:#161616;border:1px solid var(--white);font-weight:500}
.calh{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:16px}
.calh h3{margin:0!important;font:500 18px var(--geist)}.calh h3::first-letter{text-transform:uppercase}
.cal{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px}
.cal .dh{font-size:13px;color:var(--ash);padding:2px 4px}
.cd{min-height:68px;text-align:left;background:none;border:1px solid rgba(229,229,229,.25);border-radius:10px;padding:8px;cursor:pointer;display:flex;flex-direction:column;gap:2px;color:var(--bone)}
.cd b{font:500 16px var(--geist)}
.cd span{font-size:12px;color:var(--ash);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.cd i{display:none}
.cd:hover,.cd.today{border-color:var(--hair)}
.cd.sel{background:var(--white);color:#161616;border-color:var(--white)}.cd.sel span{color:#161616}
.detail{margin-top:24px;border-top:1px solid rgba(229,229,229,.15);padding-top:20px}
.detail h3{margin:0 0 8px!important}
@media(max-width:560px){.cd{min-height:52px;padding:6px}.cd span{display:none}.cd i{display:block;width:6px;height:6px;border-radius:50%;background:currentColor}}
.orb{display:none}
.eyebrow{display:block;font:500 12px/1.4 var(--dm);text-transform:uppercase;letter-spacing:.12em;color:var(--ash);margin-bottom:20px}
.err[hidden]{display:none!important}
.mxw{overflow-x:auto}
.mx{border-collapse:separate;border-spacing:3px;min-width:0;width:auto}
.mx th{padding:0 0 4px;text-align:center;font-size:11px;letter-spacing:.04em;min-width:28px}
.mx th.n{text-align:left;position:sticky;left:0;background:#003734;min-width:180px;padding-right:12px;text-transform:uppercase;letter-spacing:.12em;z-index:1}
.mx td{padding:0;text-align:center}
.mx td.n{position:sticky;left:0;background:#003734;text-align:left;font-size:14px;color:#fff;padding-right:12px;white-space:nowrap;z-index:1}
.mx td.c{width:28px;height:28px;border-radius:6px;font-size:12px;background:rgba(255,255,255,.05);color:#edfffe}
.mx td.c.m{background:#edfffe;color:#012624}.mx td.c.t{background:rgba(255,255,255,.18);color:#fff}.mx td.c.mt{background:#fde9ff;color:#012624}
.mx th.today{color:#fff}.mx th.dom{opacity:.45}
.row3{display:grid;grid-template-columns:130px 1fr 1fr;gap:16px}
.row3 label{margin-top:0}
@media(max-width:700px){.row3{grid-template-columns:1fr}}
/* Médico y login: estilo Auros (teal abisal) */
body:is(.role-m,.login){--canvas:#012624;--graphite:#003734;--glass:#003734;--bone:#edfffe;--ash:#bbc7c6;--slate:#8d9b9a;--hair:rgba(255,255,255,.14);--white:#fff;letter-spacing:0}
body:is(.role-m,.login) .wrap{max-width:1440px;padding:0 32px}
body:is(.role-m,.login) nav{top:0;left:0;right:0;transform:none;max-width:none;width:100%;border:0;border-bottom:1px solid rgba(255,255,255,.1);border-radius:0;padding:calc(14px + env(safe-area-inset-top,0px)) 32px 14px;gap:20px;background:rgba(1,38,36,.88)}
body:is(.role-m,.login) nav b{font:500 13px var(--dm);text-transform:uppercase;letter-spacing:.12em;margin-right:auto;color:#fff}
body:is(.role-m,.login) .ghost{border:1px solid rgba(255,255,255,.22);border-radius:6px;padding:10px 16px;font-size:12px;text-transform:uppercase;letter-spacing:.12em;color:var(--ash);background:none}
body:is(.role-m,.login) .ghost:hover{background:rgba(255,255,255,.08);color:#fff}
body:is(.role-m,.login) .ghost.on{background:rgba(255,255,255,.12);color:#fff}
body:is(.role-m,.login) nav .ghost{border:0;border-radius:0;padding:6px 2px}
body:is(.role-m,.login) nav .ghost:hover{background:none;color:#fff;box-shadow:0 1px 0 #fff}
body:is(.role-m,.login) .cta,body:is(.role-m,.login) .cta:hover{background:linear-gradient(90deg,#cbfffc 0%,#edfffe 26%,#fffdfa 48%,#fad1ff 89%);color:#222;border-radius:6px;padding:12px 22px;font:400 14px/1.43 Arial,system-ui,sans-serif;text-transform:uppercase;letter-spacing:.02em}
body:is(.role-m,.login) .cta:hover{filter:brightness(1.06)}
body:is(.role-m,.login) .hero{margin:0;border-radius:0;border:0;background:none;padding:150px 0 96px;position:relative;overflow:hidden;color:#fff}
body:is(.role-m,.login) .hero .wrap{position:relative;z-index:1;padding:0 32px}
body:is(.role-m,.login) .orb{display:block;position:absolute;right:max(0px,calc(50% - 720px));top:50%;transform:translateY(-50%);width:min(560px,80vw);height:min(560px,80vw);opacity:.85;pointer-events:none}
body:is(.role-m,.login) h1{font:500 clamp(44px,8vw,96px)/1 var(--dm);letter-spacing:-.04em;color:#fff;max-width:900px}
body:is(.role-m,.login) .hero p{color:var(--ash);font:400 16px/1.4 var(--dm);max-width:480px}
body:is(.role-m,.login) .stat{background:#003734;border:0;border-radius:16px;padding:28px 32px;min-width:220px;backdrop-filter:none;-webkit-backdrop-filter:none}
body:is(.role-m,.login) .stat b{font:500 clamp(40px,6vw,61px)/1 var(--dm);letter-spacing:-.04em;color:#fde9ff}
body:is(.role-m,.login) .stat span{display:block;margin-top:12px;font-size:12px;text-transform:uppercase;letter-spacing:.08em;color:#edfffe}
body:is(.role-m,.login) section{padding-top:80px}
body:is(.role-m,.login) h2{font:500 clamp(32px,5vw,61px)/1 var(--dm);letter-spacing:-.04em;color:#fff;margin:0 0 20px}
body:is(.role-m,.login) .sub{font:400 16px/1.4 var(--dm);color:var(--ash);max-width:600px;margin:0 0 36px}
body:is(.role-m,.login) .panel{background:#003734;border:0;border-radius:16px;padding:36px;backdrop-filter:none;-webkit-backdrop-filter:none;box-shadow:none}
body:is(.role-m,.login) th{font:500 12px var(--dm);text-transform:uppercase;letter-spacing:.12em}
body:is(.role-m,.login) th small{text-transform:none;letter-spacing:0;font-weight:400}
body:is(.role-m,.login) td.dr b{font-weight:500;color:#fff}
body:is(.role-m,.login) .cell{border-radius:6px;border:1px dashed rgba(255,255,255,.25)}
body:is(.role-m,.login) .cell.m{background:#edfffe;color:#012624;border:1px solid #edfffe}
body:is(.role-m,.login) .cell.t{background:rgba(255,255,255,.1);color:#fff;border:1px solid rgba(255,255,255,.35)}
body:is(.role-m,.login) .cell.mt{background:#fde9ff;color:#012624;border:1px solid #fde9ff}
body:is(.role-m,.login) .f{background:#012624;border:1px solid rgba(255,255,255,.2);border-radius:6px;color:#fff}
body:is(.role-m,.login) .x{border-radius:6px;border-color:rgba(255,255,255,.22);text-transform:uppercase;letter-spacing:.08em;font-size:12px;padding:8px 12px}
body:is(.role-m,.login) .ap{border-top-color:rgba(255,255,255,.1)}
body:is(.role-m,.login) .cd{border-radius:6px;border-color:rgba(255,255,255,.14)}
body:is(.role-m,.login) .cd:hover,body:is(.role-m,.login) .cd.today{border-color:#fff}
body:is(.role-m,.login) .cd.sel{background:#edfffe;color:#012624;border-color:#edfffe}
body:is(.role-m,.login) .cd.sel span{color:#012624}
body:is(.role-m,.login) .detail{border-top-color:rgba(255,255,255,.1)}
body:is(.role-m,.login) #toast{background:#011d1c;border:1px solid rgba(255,255,255,.2);border-radius:6px}
body:is(.role-m,.login) footer{background:#011d1c;margin-top:96px;padding:64px 0;color:var(--ash)}
body:is(.role-m,.login) .err{color:#edfffe;background:#011d1c;border-radius:6px;padding:8px 12px;display:inline-block}
body:is(.role-m,.login) .lbox{padding:36px}
